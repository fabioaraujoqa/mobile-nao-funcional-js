{
  "name": "mobile-nao-funcional-js",
  "version": "0.1.0",
  "private": true,
  "description": "Os 12 tipos de teste mobile com WebdriverIO + Appium, e um braço robótico para o toque físico",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:mobile": "wdio run wdio.conf.js",
    "test:tipos": "wdio run wdio.conf.js --suite tipos",
    "test:rapidos": "wdio run wdio.conf.js --suite rapidos",
    "test:longos": "wdio run wdio.conf.js --suite longos",
    "test:braco": "wdio run wdio.conf.js --suite braco",
    "test:funcional": "wdio run wdio.conf.js --suite funcional",
    "test:addnumber": "wdio run wdio.conf.js --suite addnumber",
    "test:demo": "wdio run wdio.conf.js --suite demo",
    "test:demo-loop": "wdio run wdio.conf.js --suite demo-loop",
    "demo": "bash scripts/demo-loop.sh",
    "test:dry-run": "mocha --dry-run \"tests/js/{tipos,outros-apps}/*.spec.js\"",
    "check": "node scripts/check.js",
    "lint": "prettier --check \"tests/js/**/*.js\" \"scripts/*.js\" wdio.conf.js",
    "format": "prettier --write \"tests/js/**/*.js\" \"scripts/*.js\" wdio.conf.js",
    "painel": "node scripts/painel.js"
  },
  "devDependencies": {
    "@wdio/cli": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/visual-service": "11.1.0",
    "d3": "7.9.0",
    "jest": "^30.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "webdriverio": "10.1.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/js/unit/**/*.test.js"
    ],
    "testEnvironment": "node"
  }
}
