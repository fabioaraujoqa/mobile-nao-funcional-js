{
  "name": "tap-robot-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Testes Android WebdriverIO e integração com o braço Python",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:mobile": "wdio run wdio.conf.js",
    "test:funcionais": "wdio run wdio.conf.js --suite funcionais",
    "test:e2e": "wdio run wdio.conf.js --suite e2e",
    "test:nfr": "wdio run wdio.conf.js --suite nfr",
    "check": "node scripts/check.js",
    "format": "prettier --write \"tests/js/**/*.js\" \"scripts/*.js\" wdio.conf.js",
    "test:dry-run": "mocha --dry-run \"tests/js/{funcionais,e2e,nao-funcionais}/*.spec.js\"",
    "lint": "prettier --check \"tests/js/**/*.js\" \"scripts/*.js\" wdio.conf.js"
  },
  "devDependencies": {
    "@wdio/cli": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "jest": "^30.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "webdriverio": "10.1.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/js/unit/**/*.test.js"
    ],
    "testEnvironment": "node"
  }
}
